{
  "name": "synthetic-acceleration",
  "workload_class": "P4",
  "duration_seconds": 10,
  "tick_ms": 50,
  "can_bitrate": 500000,
  "profile": "hondata-motec",
  "frame_rate_hz": 20,
  "signals": {
    "rpm": {"type": "keyframes", "interpolation": "linear", "keyframes": [{"at_seconds": 0, "value": 1000}, {"at_seconds": 8, "value": 8000}, {"at_seconds": 10, "value": 2500}]},
    "speed_kph": {"type": "keyframes", "interpolation": "linear", "keyframes": [{"at_seconds": 0, "value": 0}, {"at_seconds": 8, "value": 140}, {"at_seconds": 10, "value": 90}]},
    "gear": {"type": "sequence", "values": [1, 2, 3, 4], "hold_ticks": 40},
    "voltage_v": {"type": "constant", "value": 14},
    "iat_c": {"type": "constant", "value": 30},
    "ect_c": {"type": "constant", "value": 90},
    "mil": {"type": "constant", "value": 0},
    "vts": {"type": "constant", "value": 0},
    "closed_loop": {"type": "constant", "value": 1},
    "tps_pct": {"type": "keyframes", "interpolation": "linear", "keyframes": [{"at_seconds": 0, "value": 5}, {"at_seconds": 2, "value": 75}, {"at_seconds": 8, "value": 95}, {"at_seconds": 10, "value": 5}]},
    "map_kpa": {"type": "keyframes", "interpolation": "linear", "keyframes": [{"at_seconds": 0, "value": 35}, {"at_seconds": 8, "value": 180}, {"at_seconds": 10, "value": 40}]},
    "injector_ms": {"type": "keyframes", "interpolation": "linear", "keyframes": [{"at_seconds": 0, "value": 1}, {"at_seconds": 8, "value": 15}, {"at_seconds": 10, "value": 2}]},
    "ignition_deg": {"type": "keyframes", "interpolation": "linear", "keyframes": [{"at_seconds": 0, "value": 10}, {"at_seconds": 4, "value": 25}, {"at_seconds": 8, "value": 12}, {"at_seconds": 10, "value": 8}]},
    "lambda": {"type": "keyframes", "interpolation": "linear", "keyframes": [{"at_seconds": 0, "value": 1}, {"at_seconds": 2, "value": 0.9}, {"at_seconds": 8, "value": 0.82}, {"at_seconds": 10, "value": 1}]}
  }
}
