{
  "name": "maximum-frame-activity",
  "workload_class": "P5",
  "duration_seconds": 2,
  "tick_ms": 5,
  "can_bitrate": 500000,
  "profile": "hondata-motec",
  "frame_rate_hz": 200,
  "signals": {
    "rpm": {"type": "triangle", "minimum": 800, "maximum": 8000, "period_seconds": 1},
    "speed_kph": {"type": "sweep", "start": 0, "end": 200},
    "gear": {"type": "sequence", "values": [1, 2, 3, 4, 5], "hold_ticks": 20},
    "voltage_v": {"type": "sine", "center": 14, "amplitude": 0.5, "period_seconds": 1},
    "iat_c": {"type": "sweep", "start": 25, "end": 55},
    "ect_c": {"type": "sweep", "start": 80, "end": 100},
    "mil": {"type": "sequence", "values": [0, 1], "hold_ticks": 10},
    "vts": {"type": "sequence", "values": [0, 1], "hold_ticks": 7},
    "closed_loop": {"type": "sequence", "values": [0, 1], "hold_ticks": 5},
    "tps_pct": {"type": "triangle", "minimum": 0, "maximum": 100, "period_seconds": 0.8},
    "map_kpa": {"type": "sweep", "start": 30, "end": 220},
    "injector_ms": {"type": "sweep", "start": 0, "end": 20},
    "ignition_deg": {"type": "sine", "center": 15, "amplitude": 10, "period_seconds": 0.7},
    "lambda": {"type": "sine", "center": 1, "amplitude": 0.1, "period_seconds": 0.5},
    "knock_count": {"type": "sequence", "values": [0, 1, 2, 3], "hold_ticks": 3},
    "target_cam_deg": {"type": "sweep", "start": 0, "end": 40},
    "actual_cam_deg": {"type": "triangle", "minimum": 0, "maximum": 40, "period_seconds": 1},
    "analog0": {"type": "sweep", "start": 0, "end": 10},
    "analog1": {"type": "sweep", "start": 1, "end": 9},
    "analog2": {"type": "sweep", "start": 2, "end": 8},
    "analog3": {"type": "sweep", "start": 3, "end": 7},
    "analog4": {"type": "triangle", "minimum": 0, "maximum": 10, "period_seconds": 0.9},
    "analog5": {"type": "triangle", "minimum": 0, "maximum": 9, "period_seconds": 0.8},
    "analog6": {"type": "triangle", "minimum": 0, "maximum": 8, "period_seconds": 0.7},
    "analog7": {"type": "triangle", "minimum": 0, "maximum": 7, "period_seconds": 0.6},
    "frequency_hz": {"type": "sweep", "start": 0, "end": 200},
    "ethanol_pct": {"type": "sweep", "start": 0, "end": 85},
    "fuel_temp_c": {"type": "sweep", "start": 20, "end": 80}
  }
}
